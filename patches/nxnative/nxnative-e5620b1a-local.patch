+# (bionic's / glibc's TLS pointer; the guest's own tpidr_el0 accesses are rewritten to KTLS, so the register stays the host's). DM_TARGET=android selects it.
+_TP_MRS = 0xD53BD040 if os.environ.get('DM_TARGET') in ('android', 'linux') else 0xD53BD060
+def MRS_TPIDRRO(t): return _TP_MRS | t
